<resources>
    <!-- Compose handles all UI theming; this XML theme just sets the window
         background and hides the system action bar before Compose takes over. -->
    <style name="Theme.HabitTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#1A1030</item>
        <!-- The splash screen icon (we'll just use the default launcher icon for now) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <!-- Duration (max 1000ms) -->
        <item name="windowSplashScreenAnimationDuration">500</item>
        <!-- Theme to switch to after splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.HabitTracker</item>
    </style>
</resources>
